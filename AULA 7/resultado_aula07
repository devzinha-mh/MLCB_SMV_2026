tokens = ["os", "produtos", "comprados", "não", "chegaram"]
stopwords = ["os", "não"]

tokens_limpos = []

for i in tokens:
    if i in stopwords:
        continue
    elif i == "comprados":
        tokens_limpos.append("comprar")
    elif i == "chegaram":
        tokens_limpos.append("chegar")
    else:
        tokens_limpos.append(i)

print(tokens_limpos) 

