def calcular_peso_tfidf(frequencia_geral):
    if frequencia_geral == "muito_frequente":
        return 0.1
    elif frequencia_geral == "pouco_frequente":
        return 0.9
    else:
        return 0.0

palavra_teste = "vazamento"
frequencia_teste = "pouco_frequente"

peso_resultado = calcular_peso_tfidf(frequencia_teste)

